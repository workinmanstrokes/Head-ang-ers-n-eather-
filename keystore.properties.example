# Copy this file to keystore.properties on the PC that builds a release AAB.
# keystore.properties is gitignored. Never commit a real keystore or real passwords.
# storeFile is an absolute path, or a path relative to this file's folder (the repo root).
# A local release build uses this file. GitHub Actions can sign a release AAB
# instead, from ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD,
# ANDROID_KEY_ALIAS, and ANDROID_KEY_PASSWORD. That job skips when all four
# are absent. Optional public client keys SENTRY_DSN, POSTHOG_KEY, and
# POSTHOG_HOST are baked at build time. Blank keys send nothing.
storeFile=
storePassword=
keyAlias=
keyPassword=
